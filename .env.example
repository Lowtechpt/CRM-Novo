# Frontend (nao precisa de env vars para dev local)
# VITE_API_URL=http://localhost:3001/api

# Backend
PORT=3001
NODE_ENV=development

# Base de dados — só TURSO_URL. Sem ela, o backend usa `file:local.db` (dev).
# Em produção (Vercel) aponta à Turso, com TURSO_AUTH_TOKEN.
# TURSO_URL=libsql://your-db.turso.io
# TURSO_AUTH_TOKEN=your_token_here

# Autenticação (valores reais em backend/.env.local, nunca aqui)
JWT_SECRET=gerar_com_openssl_rand_hex_32
ADMIN_EMAIL=admin@exemplo.pt
ADMIN_PASSWORD=definir_password_forte
ADMIN_NAME=Nome do Administrador

# Assistente IA — Kilo Gateway
KILO_API_KEY=chave_do_kilo_aqui
KILO_MODEL=kilo-auto/free

# ── Modo demonstração (opcional) ──
# Com estas duas definidas, o login mostra "Explorar em modo demonstração" e a
# conta é criada no arranque, com papel `user`: explora e cria, não elimina.
# Servem para deploys públicos de portefólio. Nunca pôr aqui valores reais.
DEMO_EMAIL=
DEMO_PASSWORD=
DEMO_NAME=Visitante
